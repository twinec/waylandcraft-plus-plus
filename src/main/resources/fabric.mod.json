{
	"schemaVersion": 1,
	"id": "waylandcraft",
	"version": "${version}",
	"name": "WaylandCraft++",
	"description": "Wayland Compositor in Minecraft, plus some improvements. Greetz to EVV1E for the original mod",
	"authors": [
		"EVV1E",
		"twinec",
		"claude"
	],
	"icon": "assets/waylandcraft/icon.png",
	"environment": "*",
	"accessWidener": "waylandcraft.classtweaker",
	"entrypoints": {
		"main": [
			"dev.evvie.waylandcraft.WaylandCraftCommon"
		],
		"client": [
			"dev.evvie.waylandcraft.WaylandCraft"
		]
	},
	"mixins": [
		"waylandcraft.mixins.json",
		{
			"config": "waylandcraft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
